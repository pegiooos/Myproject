
name: Build GuestLab APK

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build GuestLab
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Extract GuestLab
        shell: bash
        run: |
          set -euo pipefail

          test -f GuestLab.zip || {
            echo "::error::GuestLab.zip is missing"
            exit 1
          }

          unzip -t GuestLab.zip
          mkdir -p source
          unzip -oq GuestLab.zip -d source

      - name: Locate Android project
        id: project
        shell: bash
        run: |
          set -euo pipefail

          SETTINGS="$(find source -type f \
            \( -name settings.gradle -o -name settings.gradle.kts \) \
            -not -path '*/.gradle/*' \
            -not -path '*/build/*' | head -n 1 || true)"

          if [ -n "$SETTINGS" ]; then
            ROOT="$(dirname "$SETTINGS")"
          else
            BUILD_FILE="$(find source -type f \
              \( -name build.gradle -o -name build.gradle.kts \) \
              -not -path '*/.gradle/*' \
              -not -path '*/build/*' | head -n 1 || true)"

            if [ -z "$BUILD_FILE" ]; then
              echo "::error::No Gradle build file found"
              find source -maxdepth 5 -type f | head -200
              exit 1
            fi

            ROOT="$(dirname "$BUILD_FILE")"
          fi

          echo "root=$ROOT" >> "$GITHUB_OUTPUT"
          echo "Project root: $ROOT"

      - name: Install Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Verify build tools
        run: |
          java -version
          gradle --version

      - name: Build GuestLab APK
        working-directory: ${{ steps.project.outputs.root }}
        shell: bash
        run: |
          set -uo pipefail

          set +e
          gradle assembleDebug \
            --no-daemon \
            --stacktrace \
            --warning-mode all \
            2>&1 | tee "$GITHUB_WORKSPACE/guestlab-build.log"

          STATUS=${PIPESTATUS[0]}
          set -e

          if [ "$STATUS" -ne 0 ]; then
            echo "===== BUILD FAILURE SUMMARY ====="
            grep -n -A 12 -B 3 -E \
              'What went wrong:|Caused by:|Minimum supported Gradle|requires Java|SDK location not found|Could not resolve|Could not find|error:' \
              "$GITHUB_WORKSPACE/guestlab-build.log" \
              | head -180 || true
            exit "$STATUS"
          fi

      - name: Verify APK output
        if: success()
        shell: bash
        run: |
          set -euo pipefail

          find source -type f \
            -path '*/build/outputs/apk/*/*.apk' -print

          if ! find source -type f \
            -path '*/build/outputs/apk/*/*.apk' | grep -q .; then
            echo "::error::Build completed without producing an APK"
            exit 1
          fi

      - name: Upload GuestLab APK
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: GuestLab-debug-apk
          path: source/**/build/outputs/apk/**/*.apk
          if-no-files-found: error
          retention-days: 14

      - name: Upload build log
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: GuestLab-build-log
          path: guestlab-build.log
          if-no-files-found: ignore
          retention-days: 7
          
