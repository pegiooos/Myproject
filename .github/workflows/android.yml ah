name: Build GuestLab APK

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build GuestLab
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v4

      - name: Extract GuestLab
        shell: bash
        run: |
          set -euo pipefail
          test -f GuestLab.zip || {
            echo "::error::GuestLab.zip was not found in repository root."
            find . -maxdepth 3 -type f -print
            exit 1
          }
          unzip -t GuestLab.zip
          mkdir -p source
          unzip -oq GuestLab.zip -d source

      - name: Locate Gradle project
        id: project
        shell: bash
        run: |
          set -euo pipefail
          SETTINGS="$(find source -type f \( -name settings.gradle -o -name settings.gradle.kts \) -not -path '*/.gradle/*' -not -path '*/build/*' | head -n 1 || true)"
          if [ -n "$SETTINGS" ]; then
            ROOT="$(dirname "$SETTINGS")"
          else
            BUILD="$(find source -type f \( -name build.gradle -o -name build.gradle.kts \) -not -path '*/.gradle/*' -not -path '*/build/*' | head -n 1 || true)"
            test -n "$BUILD" || { echo "::error::No Gradle build files found in GuestLab.zip."; exit 1; }
            ROOT="$(dirname "$BUILD")"
          fi
          echo "root=$ROOT" >> "$GITHUB_OUTPUT"
          echo "Project root: $ROOT"

      - name: Install Android SDK platform 34
        shell: bash
        run: sdkmanager --install "platforms;android-34" "build-tools;34.0.0"

      - name: Install Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Verify selected Gradle
        shell: bash
        run: |
          set -euo pipefail
          gradle --version
          gradle --version | grep -q 'Gradle 8.9'

      - name: Build GuestLab
        working-directory: ${{ steps.project.outputs.root }}
        shell: bash
        run: |
          set -uo pipefail
          # Use installed Gradle 8.9 rather than any older wrapper in the ZIP.
          set +e
          gradle assembleDebug --no-daemon --stacktrace --console=plain 2>&1 | tee "$GITHUB_WORKSPACE/guestlab-build.log"
          STATUS=${PIPESTATUS[0]}
          set -e
          if [ "$STATUS" -ne 0 ]; then
            echo "===== Build error summary ====="
            grep -n -A 12 -B 3 -E 'What went wrong:|Caused by:|Minimum supported Gradle|SDK location not found|Could not resolve|Could not find|Unresolved reference|e: file:|error:' "$GITHUB_WORKSPACE/guestlab-build.log" | head -180 || true
            exit "$STATUS"
          fi

      - name: Upload GuestLab APK
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: GuestLab-debug-apk
          path: source/**/build/outputs/apk/debug/*.apk
          if-no-files-found: error
          retention-days: 14

      - name: Upload build log
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: GuestLab-build-log
          path: guestlab-build.log
          if-no-files-found: ignore
          retention-days: 7
