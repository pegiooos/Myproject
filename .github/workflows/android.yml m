
name: Build GuestLab APK

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build GuestLab
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Extract GuestLab source
        shell: bash
        run: |
          set -euo pipefail
          test -f GuestLab.zip
          unzip -t GuestLab.zip
          mkdir -p source
          unzip -oq GuestLab.zip -d source
          test -f source/GuestLab/app/build.gradle.kts

      - name: Install Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Verify Gradle version
        run: |
          gradle --version
          gradle --version | grep -q 'Gradle 8.9'

      - name: Build GuestLab APK
        working-directory: source/GuestLab
        shell: bash
        run: |
          set -uo pipefail

          set +e
          gradle assembleDebug \
            --no-daemon \
            --stacktrace \
            2>&1 | tee "$GITHUB_WORKSPACE/guestlab-build.log"
          STATUS=${PIPESTATUS[0]}
          set -e

          if [ "$STATUS" -ne 0 ]; then
            echo "===== BUILD ERROR ====="
            grep -n -A 12 -B 3 -E \
              'What went wrong:|Caused by:|Minimum supported Gradle|SDK location not found|Could not resolve|Could not find|error:' \
              "$GITHUB_WORKSPACE/guestlab-build.log" \
              | head -160 || true
            exit "$STATUS"
          fi

      - name: Verify APK
        if: success()
        shell: bash
        run: |
          set -euo pipefail
          find source/GuestLab -type f \
            -path '*/build/outputs/apk/*/*.apk' -print
          find source/GuestLab -type f \
            -path '*/build/outputs/apk/*/*.apk' | grep -q . || {
              echo "::error::No APK was generated"
              exit 1
            }

      - name: Upload GuestLab APK
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: GuestLab-debug-apk
          path: source/GuestLab/**/build/outputs/apk/**/*.apk
          if-no-files-found: error
          retention-days: 14

      - name: Upload build log
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: GuestLab-build-log
          path: guestlab-build.log
          if-no-files-found: ignore
          retention-days: 7
          
