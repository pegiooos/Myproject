
name: Build GuestLab APK

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build GuestLab
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Extract GuestLab source
        shell: bash
        run: |
          set -euo pipefail

          if [ ! -f GuestLab.zip ]; then
            echo "::error::GuestLab.zip was not found in the repository root."
            exit 1
          fi

          unzip -t GuestLab.zip
          mkdir -p source
          unzip -oq GuestLab.zip -d source

          echo "Extracted project files:"
          find source -maxdepth 4 -type f | head -200

      - name: Locate Android project
        id: project
        shell: bash
        run: |
          set -euo pipefail

          SETTINGS="$(find source -type f \
            \( -name settings.gradle -o -name settings.gradle.kts \) \
            -not -path '*/.gradle/*' \
            -not -path '*/build/*' | head -n 1 || true)"

          if [ -n "$SETTINGS" ]; then
            ROOT="$(dirname "$SETTINGS")"
          else
            BUILD_FILE="$(find source -type f \
              \( -name build.gradle -o -name build.gradle.kts \) \
              -not -path '*/.gradle/*' \
              -not -path '*/build/*' | head -n 1 || true)"

            if [ -z "$BUILD_FILE" ]; then
              echo "::error::No Gradle build files found in GuestLab.zip."
              exit 1
            fi

            ROOT="$(dirname "$BUILD_FILE")"
          fi

          echo "root=$ROOT" >> "$GITHUB_OUTPUT"
          echo "Android project root: $ROOT"

          find "$ROOT" -maxdepth 3 -type f \
            \( -name 'build.gradle' -o \
               -name 'build.gradle.kts' -o \
               -name 'settings.gradle' -o \
               -name 'settings.gradle.kts' -o \
               -name 'gradle-wrapper.properties' \) -print

      - name: Set up Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Build debug APK
        working-directory: ${{ steps.project.outputs.root }}
        shell: bash
        run: |
          set -uo pipefail

          if [ -f gradlew ]; then
            chmod +x gradlew
            GRADLE=./gradlew
          else
            GRADLE=gradle
          fi

          set +e
          "$GRADLE" assembleDebug \
            --no-daemon \
            --stacktrace \
            --warning-mode all \
            2>&1 | tee "$GITHUB_WORKSPACE/guestlab-build.log"

          STATUS=${PIPESTATUS[0]}
          set -e

          if [ "$STATUS" -ne 0 ]; then
            echo
            echo "===== BUILD ERROR SUMMARY ====="
            grep -n -A 10 -B 3 -E \
              'What went wrong:|Caused by:|Minimum supported Gradle|requires Java|SDK location not found|Could not resolve|Could not find|error:' \
              "$GITHUB_WORKSPACE/guestlab-build.log" \
              | head -160 || true
            exit "$STATUS"
          fi

      - name: Find generated APKs
        if: success()
        shell: bash
        run: |
          set -euo pipefail

          find source -type f -path '*/build/outputs/apk/*/*.apk' \
            -print -exec ls -lh {} \;

          if ! find source -type f \
            -path '*/build/outputs/apk/*/*.apk' | grep -q .; then
            echo "::error::Build succeeded but no APK was found."
            exit 1
          fi

      - name: Upload GuestLab APK
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: GuestLab-debug-apk
          path: source/**/build/outputs/apk/**/*.apk
          if-no-files-found: error
          retention-days: 14

      - name: Upload build log
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: GuestLab-build-log
          path: guestlab-build.log
          if-no-files-found: ignore
          retention-days: 7
          
